{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "grainatlas",
  "version": "0.1.13",
  "identifier": "org.grainatlas.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "grainatlas",
        "width": 1280,
        "height": 800,
        "center": true,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#eef2f8"
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGMTQ2MTM2NjNCNjVBRDAKUldUUVdyWmpObUVVLzZsdDMySW5IY1ZWRlEzdnRJNnhzSit6NHNkaFJVdnNnWmdMNjJVd2pXMTMK",
      "endpoints": ["https://github.com/duserzym/grainatlas/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "SEM grain-mount stitching, segmentation, spots and print layout",
    "copyright": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "fileAssociations": [
      { "ext": ["gaproj"], "name": "grainatlas project", "description": "grainatlas project (parameters, grains, spots; images stay in the package)", "role": "Editor", "mimeType": "application/x-grainatlas-project" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" },
      "wix": { "language": "en-US" }
    }
  }
}
